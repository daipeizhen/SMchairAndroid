{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter Android Emulator",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "emulator-5554"
    },
    {
      "name": "Flutter Android Emulator (With API)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "emulator-5554",
      "args": [
        "--dart-define=API_BASE_URL=${input:apiBaseUrl}"
      ]
    }
  ],
  "inputs": [
    {
      "id": "apiBaseUrl",
      "type": "promptString",
      "description": "API_BASE_URL",
      "default": "https://sandbar-badass-subfloor.ngrok-free.dev/api"
    }
  ]
}
